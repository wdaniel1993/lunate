<Project Sdk="Microsoft.NET.Sdk">
    <!--
        The contract reaches a template as packages (the stable pair pinned to the version
        ExtensionApi.Current names) and as projects while the template sits inside this
        repository, where the packages a feed serves may not exist yet. LunateUseNuGetContracts
        switches the two: it defaults to true when the repository the template was copied from
        is far enough away, and the verify gate forces it to true to prove the package shape
        against a feed of freshly packed packages.
    -->
    <PropertyGroup Condition="'$(LunateUseNuGetContracts)' == ''">
        <LunateUseNuGetContracts
            Condition="!Exists('../../../src/Lunate.Contracts/Lunate.Contracts.csproj')"
            >true</LunateUseNuGetContracts>
        <LunateUseNuGetContracts
            Condition="Exists('../../../src/Lunate.Contracts/Lunate.Contracts.csproj')"
            >false</LunateUseNuGetContracts>
    </PropertyGroup>

    <PropertyGroup>
        <RootNamespace>TemplateExtension</RootNamespace>
    </PropertyGroup>

    <!--
        The contracts a copied template pins must be installable. Inside this repository the pinned
        version follows the release being built, so an RC pins `1.15.0-rc.N` — the only contract
        version that exists for that tag — and a final tag pins `1.15.0`. Outside the repository
        there is no release context, so the stable API version is the only thing that can exist.
    -->
    <PropertyGroup Condition="'$(LunateContractsVersion)' == ''">
        <LunateContractsVersion Condition="'$(ContractVersion)' != ''">$(ContractVersion)</LunateContractsVersion>
        <LunateContractsVersion Condition="'$(ContractVersion)' == ''">1.15.0</LunateContractsVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- snippet:start — included by docs/extensions/README.md through scripts/docs-sync; keep the markers -->
        <!--
            The host owns Lunate.Contracts and Lunate.Extensibility.Abstractions and loads them once;
            every extension binds to those copies so their types keep one identity. They are NuGet
            packages pinned to the stable contract version (1.15.0, the number the manifest's
            apiVersion is judged against), and each reference is compile-only: PrivateAssets="all"
            keeps them from flowing to consumers of a packaged extension, ExcludeAssets="runtime"
            keeps them out of the deps file and the output directory — a copy there is ignored at
            load, with one warning saying so.
        -->
        <PackageReference
            Condition="'$(LunateUseNuGetContracts)' == 'true'"
            Include="Lunate.Contracts"
            Version="$(LunateContractsVersion)"
            PrivateAssets="all"
            ExcludeAssets="runtime"
        />
        <PackageReference
            Condition="'$(LunateUseNuGetContracts)' == 'true'"
            Include="Lunate.Extensibility.Abstractions"
            Version="$(LunateContractsVersion)"
            PrivateAssets="all"
            ExcludeAssets="runtime"
        />
        <!-- snippet:end -->
    </ItemGroup>

    <ItemGroup>
        <ProjectReference
            Condition="'$(LunateUseNuGetContracts)' != 'true'"
            Include="../../../src/Lunate.Contracts/Lunate.Contracts.csproj"
            PrivateAssets="all"
            Private="false"
            ExcludeAssets="runtime"
        />
        <ProjectReference
            Condition="'$(LunateUseNuGetContracts)' != 'true'"
            Include="../../../src/Lunate.Extensibility.Abstractions/Lunate.Extensibility.Abstractions.csproj"
            PrivateAssets="all"
            Private="false"
            ExcludeAssets="runtime"
        />
    </ItemGroup>

    <ItemGroup>
        <None Update="extension.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
