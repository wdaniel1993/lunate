<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Lunate.Coding.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/Lunate.Coding/Lunate.Coding.csproj" />
        <ProjectReference Include="../../src/Lunate.Roslyn.BuiltIn/Lunate.Roslyn.BuiltIn.csproj" />
        <ProjectReference
            Include="../TestExtensions/HelloExtension/HelloExtension.csproj"
            ReferenceOutputAssembly="false"
        />
        <!-- The extension-MCP tests install this fixture extension into a temp store. -->
        <ProjectReference
            Include="../TestExtensions/McpExtension/McpExtension.csproj"
            ReferenceOutputAssembly="false"
        />
        <!-- The extension-tool tests install this fixture extension into a temp store. -->
        <ProjectReference
            Include="../TestExtensions/ToolExtension/ToolExtension.csproj"
            ReferenceOutputAssembly="false"
        />
        <!-- The command-source tests install this fixture extension into a temp store. -->
        <ProjectReference
            Include="../TestExtensions/CommandExtension/CommandExtension.csproj"
            ReferenceOutputAssembly="false"
        />
        <!-- The model-registry wiring tests install this fixture extension into a temp store. -->
        <ProjectReference
            Include="../TestExtensions/ModelExtension/ModelExtension.csproj"
            ReferenceOutputAssembly="false"
        />
        <!-- The extension-skills tests install this fixture extension into a temp store. -->
        <ProjectReference
            Include="../TestExtensions/SkillSourceExtension/SkillSourceExtension.csproj"
            ReferenceOutputAssembly="false"
        />
        <!-- The service-composition tests install this fixture extension into a temp store. -->
        <ProjectReference
            Include="../TestExtensions/ServiceConsumerExtension/ServiceConsumerExtension.csproj"
            ReferenceOutputAssembly="false"
        />
        <!-- The ui-showcase mode proofs install the sample into a temp store. -->
        <ProjectReference
            Include="../../samples/extensions/ui-showcase/UiShowcaseExtension/UiShowcaseExtension.csproj"
            ReferenceOutputAssembly="false"
        />
        <!-- The MCP config e2e tests spawn the shared stdio test server. -->
        <ProjectReference
            Include="../tools/TestMcpServer/TestMcpServer.csproj"
            ReferenceOutputAssembly="false"
        />
        <ProjectReference Include="../Lunate.TestSupport/Lunate.TestSupport.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="4.0.1" />
        <PackageReference Include="Spectre.Console.Testing" Version="0.57.2" />
        <Using Include="Xunit" />
        <Using Include="Lunate.TestSupport" />
    </ItemGroup>

    <Target Name="CopyTestExtensions" AfterTargets="Build">
        <MSBuild
            Projects="$(MSBuildThisFileDirectory)../TestExtensions/HelloExtension/HelloExtension.csproj"
            Targets="Build"
            Properties="Configuration=$(Configuration)"
        />
        <MSBuild
            Projects="$(MSBuildThisFileDirectory)../TestExtensions/McpExtension/McpExtension.csproj"
            Targets="Build"
            Properties="Configuration=$(Configuration)"
        />
        <MSBuild
            Projects="$(MSBuildThisFileDirectory)../TestExtensions/ToolExtension/ToolExtension.csproj"
            Targets="Build"
            Properties="Configuration=$(Configuration)"
        />
        <MSBuild
            Projects="$(MSBuildThisFileDirectory)../TestExtensions/CommandExtension/CommandExtension.csproj"
            Targets="Build"
            Properties="Configuration=$(Configuration)"
        />
        <MSBuild
            Projects="$(MSBuildThisFileDirectory)../TestExtensions/ModelExtension/ModelExtension.csproj"
            Targets="Build"
            Properties="Configuration=$(Configuration)"
        />
        <MSBuild
            Projects="$(MSBuildThisFileDirectory)../TestExtensions/SkillSourceExtension/SkillSourceExtension.csproj"
            Targets="Build"
            Properties="Configuration=$(Configuration)"
        />
        <MSBuild
            Projects="$(MSBuildThisFileDirectory)../TestExtensions/ServiceConsumerExtension/ServiceConsumerExtension.csproj"
            Targets="Build"
            Properties="Configuration=$(Configuration)"
        />
        <MSBuild
            Projects="$(MSBuildThisFileDirectory)../../samples/extensions/ui-showcase/UiShowcaseExtension/UiShowcaseExtension.csproj"
            Targets="Build"
            Properties="Configuration=$(Configuration)"
        />
        <ItemGroup>
            <HelloExtensionFiles Include="$(MSBuildThisFileDirectory)../TestExtensions/HelloExtension/bin/$(Configuration)/$(TargetFramework)/**/*" />
            <McpExtensionFiles Include="$(MSBuildThisFileDirectory)../TestExtensions/McpExtension/bin/$(Configuration)/$(TargetFramework)/**/*" />
            <ToolExtensionFiles Include="$(MSBuildThisFileDirectory)../TestExtensions/ToolExtension/bin/$(Configuration)/$(TargetFramework)/**/*" />
            <CommandExtensionFiles Include="$(MSBuildThisFileDirectory)../TestExtensions/CommandExtension/bin/$(Configuration)/$(TargetFramework)/**/*" />
            <ModelExtensionFiles Include="$(MSBuildThisFileDirectory)../TestExtensions/ModelExtension/bin/$(Configuration)/$(TargetFramework)/**/*" />
            <SkillSourceExtensionFiles Include="$(MSBuildThisFileDirectory)../TestExtensions/SkillSourceExtension/bin/$(Configuration)/$(TargetFramework)/**/*" />
            <ServiceConsumerExtensionFiles Include="$(MSBuildThisFileDirectory)../TestExtensions/ServiceConsumerExtension/bin/$(Configuration)/$(TargetFramework)/**/*" />
            <UiShowcaseExtensionFiles Include="$(MSBuildThisFileDirectory)../../samples/extensions/ui-showcase/UiShowcaseExtension/bin/$(Configuration)/$(TargetFramework)/**/*" />
        </ItemGroup>
        <Copy
            SourceFiles="@(HelloExtensionFiles)"
            DestinationFolder="$(OutDir)TestExtensions/HelloExtension/%(RecursiveDir)"
            SkipUnchangedFiles="true"
        />
        <Copy
            SourceFiles="@(McpExtensionFiles)"
            DestinationFolder="$(OutDir)TestExtensions/McpExtension/%(RecursiveDir)"
            SkipUnchangedFiles="true"
        />
        <Copy
            SourceFiles="@(ToolExtensionFiles)"
            DestinationFolder="$(OutDir)TestExtensions/ToolExtension/%(RecursiveDir)"
            SkipUnchangedFiles="true"
        />
        <Copy
            SourceFiles="@(CommandExtensionFiles)"
            DestinationFolder="$(OutDir)TestExtensions/CommandExtension/%(RecursiveDir)"
            SkipUnchangedFiles="true"
        />
        <Copy
            SourceFiles="@(ModelExtensionFiles)"
            DestinationFolder="$(OutDir)TestExtensions/ModelExtension/%(RecursiveDir)"
            SkipUnchangedFiles="true"
        />
        <Copy
            SourceFiles="@(SkillSourceExtensionFiles)"
            DestinationFolder="$(OutDir)TestExtensions/SkillSourceExtension/%(RecursiveDir)"
            SkipUnchangedFiles="true"
        />
        <Copy
            SourceFiles="@(ServiceConsumerExtensionFiles)"
            DestinationFolder="$(OutDir)TestExtensions/ServiceConsumerExtension/%(RecursiveDir)"
            SkipUnchangedFiles="true"
        />
        <Copy
            SourceFiles="@(UiShowcaseExtensionFiles)"
            DestinationFolder="$(OutDir)Samples/UiShowcaseExtension/%(RecursiveDir)"
            SkipUnchangedFiles="true"
        />
    </Target>
</Project>
