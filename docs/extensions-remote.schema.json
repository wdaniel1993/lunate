        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "finishReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "parentRunId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "runId"
      ]
    },
    "MessageCompletedPayload": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "parentRunId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "runId",
        "role",
        "text"
      ]
    },
    "ToolCallingPayload": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string"
        },
        "callId": {
          "type": "string"
        },
        "toolName": {
          "type": "string"
        },
        "arguments": {
          "description": "any JSON value"
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parentRunId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "runId",
        "callId",
        "toolName",
        "arguments",
        "annotations"
      ]
    },
    "ToolResultReadyPayload": {
      "type": "object",
