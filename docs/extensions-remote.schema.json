{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunate.dev/schemas/remote-extension-wire.json",
  "title": "Lunate remote extension wire (protocol version 1)",
  "description": "JSON-RPC 2.0 over newline-delimited UTF-8 JSON on stdio. Stdout is protocol-only; a non-JSON line or a line over 16 MB is a protocol error. Interceptor hooks are requests, observer hooks are notifications, service-call is a request, and $/cancelRequest carries { id }.",
  "type": "object",
  "properties": {
    "initialize.request": {
      "$ref": "#/$defs/InitializeRequest"
    },
    "initialize.result": {
      "$ref": "#/$defs/InitializeResult"
    },
    "hook.request": {
      "$ref": "#/$defs/HookCallEnvelope"
    },
    "hook.results": {
      "type": "object",
      "properties": {
        "ProjectTrust": {
          "$ref": "#/$defs/ProjectTrustResult"
        },
        "InputReceived": {
          "$ref": "#/$defs/InputReceivedResult"
        },
        "RunStarting": {
          "$ref": "#/$defs/RunStartingResult"
        },
        "ContextBuilding": {
          "$ref": "#/$defs/ContextBuildingResult"
        },
        "MessageCompleted": {
          "$ref": "#/$defs/MessageCompletedResult"
        },
        "ToolCalling": {
          "$ref": "#/$defs/ToolCallingResult"
        },
        "ToolResultReady": {
          "$ref": "#/$defs/ToolResultReadyResult"
        },
        "TurnEnded": {
          "$ref": "#/$defs/TurnEndedResult"
        },
        "Compacting": {
          "$ref": "#/$defs/CompactingResult"
        }
      }
    },
    "service-call": {
      "$ref": "#/$defs/ServiceCallEnvelope"
    },
    "cancel": {
      "type": "object",
      "properties": {
        "id": {
          "description": "the request id being cancelled (string or number)",
          "type": [
            "string",
            "number"
          ]
        }
      },
      "required": [
        "id"
      ]
    }
  },
  "$defs": {
    "ProjectTrustPayload": {
      "type": "object",
      "properties": {
        "extensionId": {
          "type": "string"
        },
        "extensionDirectory": {
          "type": "string"
        },
        "repositoryIdentity": {
          "type": "string"
        },
        "worktreePath": {
          "type": "string"
        }
      },
      "required": [
        "extensionId",
        "extensionDirectory",
        "repositoryIdentity",
        "worktreePath"
      ]
    },
    "SessionStartedPayload": {
      "type": "object",
      "properties": {
        "workingDirectory": {
          "type": "string"
        },
        "repositoryIdentity": {
          "type": "string"
        }
      },
      "required": [
        "workingDirectory",
        "repositoryIdentity"
      ]
    },
    "SessionEndingPayload": {
      "type": "object",
      "properties": {
        "workingDirectory": {
          "type": "string"
        },
        "repositoryIdentity": {
          "type": "string"
        }
      },
      "required": [
        "workingDirectory",
        "repositoryIdentity"
      ]
    },
    "InputReceivedPayload": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ]
    },
    "RunStartingPayload": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string"
        },
        "sections": {
          "type": "array",
