    "ProjectTrustResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "outcome": {
              "const": "allow",
              "description": "the result variant discriminator"
            }
          },
          "required": [
            "outcome"
          ],
          "title": "Allow"
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "outcome": {
              "const": "deny",
              "description": "the result variant discriminator"
            }
          },
          "required": [
            "reason",
            "outcome"
          ],
          "title": "Deny"
        }
      ]
    },
    "InputReceivedResult": {
