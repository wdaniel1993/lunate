                  "source": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "activeTools": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "outcome": {
              "const": "apply",
              "description": "the result variant discriminator"
            }
          },
          "required": [
            "sectionEdits",
            "outcome"
          ],
          "title": "Apply"
        }
      ]
