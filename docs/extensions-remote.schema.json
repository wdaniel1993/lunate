            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "text"
            ]
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parentRunId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "runId",
        "sections",
        "tools"
      ]
    },
    "ContextBuildingPayload": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
