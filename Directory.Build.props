<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
        <IsPackable>false</IsPackable>
        <Version>0.2.0-rc.2</Version>

        <!--
            The contract assemblies carry the API version, not the product version (ADR-0002's
            addendum: `Lunate.Contracts` and `Lunate.Extensibility.Abstractions` publish together,
            in lockstep, under `ExtensionApi`). The pre-release suffix follows the product version's
            suffix, because a NuGet version cannot be deleted: releasing `v0.2.0-rc.1` must publish
            `1.15.0-rc.1`, and only the final tag may publish the stable `1.15.0`. `ExtensionApi`
            itself stays `1.15.0` — it compares assembly identity, and a prerelease package version
            does not change the assembly version.
        -->
        <ContractApiVersion>1.15.0</ContractApiVersion>
        <ContractVersionSuffix Condition="$(Version.Contains('-'))"
            >$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^[0-9.]+(-.+)$').Groups[1].Value)</ContractVersionSuffix>
        <ContractVersion>$(ContractApiVersion)$(ContractVersionSuffix)</ContractVersion>

        <!--
            The embedded harness and the test kit are preview packages: they carry the product
            version as long as it is already a prerelease (`0.2.0-rc.1`), and otherwise carry the
            product version with the preview marker (`0.2.0` -> `0.2.0-preview.1`). The rule the
            release follows is one sentence: an RC tag never publishes a stable version of anything.
        -->
        <PreviewVersion Condition="$(Version.Contains('-'))">$(Version)</PreviewVersion>
        <PreviewVersion Condition="!$(Version.Contains('-'))">$(Version)-preview.1</PreviewVersion>

        <!--
            The in-process restore engine ships NuGet.Frameworks as a runtime asset — it parses the
            TFM and picks the nearest framework group — and MSBuild ships its own copy of the same
            assembly. Microsoft.Build.Locator's MSBL001 check cannot express the rule that actually
            matters ("no Microsoft.Build.* assembly is copied beside the app"), so it is disabled
            here and that rule is enforced by a test instead: Lunate.Coding.Tests'
            AssemblyLayoutTests. The overlap itself is bounded: MSBuild's NuGet.Frameworks is loaded
            only by the Roslyn workspace path, Lunate's only when a restore runs. ADR 0017 addendum
            records the decision.
        -->
        <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
    </PropertyGroup>
</Project>
