<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>ModelRouterExtension.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../../../src/Lunate.Ai/Lunate.Ai.csproj" />
        <ProjectReference Include="../../../../src/Lunate.Extensibility.Testing/Lunate.Extensibility.Testing.csproj" />
        <!-- The kit is private about its project references when it packs (#237) — the loader the
             tests drive is named here, not assumed transitively. -->
        <ProjectReference Include="../../../../src/Lunate.Extensibility/Lunate.Extensibility.csproj" />
        <ProjectReference Include="../ModelRouterExtension/ModelRouterExtension.csproj" />
        <ProjectReference
            Include="../../../../extensions/subagents/SubagentsExtension/SubagentsExtension.csproj"
            ReferenceOutputAssembly="false"
        />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="4.0.1" />
        <Using Include="Xunit" />
    </ItemGroup>

    <Target Name="CopySampleExtensions" AfterTargets="Build">
        <MSBuild
            Projects="$(MSBuildThisFileDirectory)../ModelRouterExtension/ModelRouterExtension.csproj"
            Targets="Build"
            Properties="Configuration=$(Configuration)"
        />
        <MSBuild
            Projects="$(MSBuildThisFileDirectory)../../../../extensions/subagents/SubagentsExtension/SubagentsExtension.csproj"
            Targets="Build"
            Properties="Configuration=$(Configuration)"
        />
        <ItemGroup>
            <ModelRouterFiles Include="$(MSBuildThisFileDirectory)../ModelRouterExtension/bin/$(Configuration)/$(TargetFramework)/**/*" />
            <SubagentsFiles Include="$(MSBuildThisFileDirectory)../../../../extensions/subagents/SubagentsExtension/bin/$(Configuration)/$(TargetFramework)/**/*" />
        </ItemGroup>
        <Copy
            SourceFiles="@(ModelRouterFiles)"
            DestinationFolder="$(OutDir)ModelRouterExtension/%(RecursiveDir)"
            SkipUnchangedFiles="true"
        />
        <Copy
            SourceFiles="@(SubagentsFiles)"
            DestinationFolder="$(OutDir)SubagentsExtension/%(RecursiveDir)"
            SkipUnchangedFiles="true"
        />
    </Target>
</Project>
