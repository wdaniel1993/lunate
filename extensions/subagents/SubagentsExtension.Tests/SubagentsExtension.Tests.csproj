<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>SubagentsExtension.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../../src/Lunate.Extensibility.Testing/Lunate.Extensibility.Testing.csproj" />
        <ProjectReference Include="../SubagentsExtension/SubagentsExtension.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="4.0.1" />
        <Using Include="Xunit" />
    </ItemGroup>

    <Target Name="CopySampleExtension" AfterTargets="Build">
        <MSBuild
            Projects="$(MSBuildThisFileDirectory)../SubagentsExtension/SubagentsExtension.csproj"
            Targets="Build"
            Properties="Configuration=$(Configuration)"
        />
        <ItemGroup>
            <SampleExtensionFiles Include="$(MSBuildThisFileDirectory)../SubagentsExtension/bin/$(Configuration)/$(TargetFramework)/**/*" />
        </ItemGroup>
        <Copy
            SourceFiles="@(SampleExtensionFiles)"
            DestinationFolder="$(OutDir)SubagentsExtension/%(RecursiveDir)"
            SkipUnchangedFiles="true"
        />
    </Target>
</Project>
