<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <ProjectReference Include="../Lunate.Contracts/Lunate.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Official Anthropic SDK (ADR-0010, option A). PrivateAssets=compile keeps the provider
         compile surface out of consumers while runtime assets still flow to the app output. -->
        <PackageReference Include="Anthropic" Version="12.53.0" PrivateAssets="compile" />
        <PackageReference
            Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
            Version="5.6.0"
            PrivateAssets="all"
        />
        <!-- No Microsoft.Extensions.AI 10.10.1 exists on nuget.org; Abstractions and the OpenAI adapter move independently and are pinned at 10.10.1. -->
        <PackageReference
            Include="Microsoft.Extensions.AI"
            Version="10.10.0"
            PrivateAssets="compile"
        />
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
        <PackageReference
            Include="Microsoft.Extensions.AI.OpenAI"
            Version="10.10.1"
            PrivateAssets="compile"
        />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="PublicAPI.Shipped.txt" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="models.json" LogicalName="Lunate.Ai.models.json" />
        <EmbeddedResource Include="providers.json" LogicalName="Lunate.Ai.providers.json" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Lunate.Ai.Tests" />
        <!-- The credential probe applies the same own-endpoint rule as the client factory. -->
        <InternalsVisibleTo Include="Lunate.Coding" />
        <InternalsVisibleTo Include="Lunate.Coding.Tests" />
        <!-- The CLI refresh reuses the one default managed-catalog path instead of duplicating it. -->
        <InternalsVisibleTo Include="lunate" />
        <!-- The session format tests pin request digests with the replay format's own hash. -->
        <InternalsVisibleTo Include="Lunate.Agent.Tests" />
        <!-- The state root is one rule: the agent, the extensions host and its files all read it. -->
        <InternalsVisibleTo Include="Lunate.Agent" />
        <InternalsVisibleTo Include="Lunate.Extensibility" />
        <!-- The package install and uninstall claim one package's record with the same lock. -->
        <InternalsVisibleTo Include="Lunate.Extensibility.Restore" />
    </ItemGroup>
</Project>
