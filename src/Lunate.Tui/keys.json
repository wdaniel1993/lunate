{
    "version": 1,
    "bindings": [
        { "id": "newline.ctrl-j", "keys": [{ "kind": "Character", "ctrl": true, "alt": false, "text": "j" }], "intent": "Edit", "context": "None", "description": "Insert a newline" },
        { "id": "enter.follow-up", "keys": [{ "kind": "Enter", "ctrl": false, "alt": false, "shift": false }], "intent": "FollowUp", "context": "Running", "description": "Queue this message as a follow-up" },
        { "id": "enter.submit.idle", "keys": [{ "kind": "Enter", "ctrl": false, "alt": false, "shift": false }], "intent": "Submit", "context": "Idle", "description": "Send the message" },
        { "id": "enter.submit.bash", "keys": [{ "kind": "Enter", "ctrl": false, "alt": false, "shift": false }], "intent": "Submit", "context": "Bash", "description": "Run the bash line" },
        { "id": "newline.alt-enter", "keys": [{ "kind": "Enter", "alt": true }], "intent": "Edit", "context": "None", "description": "Insert a newline" },
        { "id": "newline.shift-enter", "keys": [{ "kind": "Enter", "shift": true }], "intent": "Edit", "context": "None", "description": "Insert a newline" },
        { "id": "newline.ctrl-enter", "keys": [{ "kind": "Enter", "ctrl": true }], "intent": "Edit", "context": "None", "description": "Insert a newline" },
        { "id": "escape.interrupt", "keys": [{ "kind": "Escape" }], "intent": "Cancel", "context": "None", "description": "Interrupt the turn" },
        { "id": "ctrl-c.interrupt.turn", "keys": [{ "kind": "Character", "ctrl": true, "alt": false, "text": "c" }], "intent": "Interrupt", "context": "Running", "description": "Interrupt the turn" },
        { "id": "ctrl-c.interrupt.command", "keys": [{ "kind": "Character", "ctrl": true, "alt": false, "text": "c" }], "intent": "Interrupt", "context": "Bash", "description": "Interrupt the command" },
        { "id": "ctrl-c.clear-or-quit", "keys": [{ "kind": "Character", "ctrl": true, "alt": false, "text": "c" }], "intent": "ClearOrQuit", "context": "None", "description": "Clear the input, or quit on a second press" },
        { "id": "ctrl-d.quit", "keys": [{ "kind": "Character", "ctrl": true, "alt": false, "text": "d" }], "intent": "Exit", "context": "None", "description": "Quit on a second press within 800 ms" },
        { "id": "ctrl-l.redraw", "keys": [{ "kind": "Character", "ctrl": true, "alt": false, "text": "l" }], "intent": "Redraw", "context": "None", "description": "Redraw the prompt" },
        { "id": "alt-p.model-picker", "keys": [{ "kind": "Character", "ctrl": false, "alt": true, "text": "p" }], "intent": "ModelPicker", "context": "None", "description": "Choose a model" },
        { "id": "ctrl-o.transcript", "keys": [{ "kind": "Character", "ctrl": true, "alt": false, "text": "o" }], "intent": "TranscriptViewer", "context": "None", "description": "Open the transcript viewer" },
        { "id": "ctrl-x.copy", "keys": [{ "kind": "Character", "ctrl": true, "alt": false, "text": "x" }], "intent": "Copy", "context": "None", "description": "Copy the last answer" },
        { "id": "tab.complete", "keys": [{ "kind": "Tab", "ctrl": false, "alt": false, "shift": false }], "intent": "Complete", "context": "None", "description": "Complete a command or path" },
        { "id": "up.take-back", "keys": [{ "kind": "Up", "ctrl": false, "alt": false }], "intent": "FollowUpTakeBack", "context": "HasQueue", "description": "Take the queued messages back" },
        { "id": "ctrl-s.stash", "keys": [{ "kind": "Character", "ctrl": true, "alt": false, "text": "s" }], "intent": "Stash", "context": "None", "description": "Stash or restore the draft" },
        { "id": "ctrl-r.history-search", "keys": [{ "kind": "Character", "ctrl": true, "alt": false, "text": "r" }], "intent": "HistorySearch", "context": "None", "description": "Search the history" },
        { "id": "ctrl-g.editor", "keys": [{ "kind": "Character", "ctrl": true, "alt": false, "shift": false, "text": "g" }], "intent": "Editor", "context": "None", "description": "Open the draft in your editor" },
        { "id": "ctrl-a.line-start", "keys": [{ "kind": "Character", "ctrl": true, "alt": false, "text": "a" }], "intent": "LineStart", "context": "None", "description": "Move to the start of the line" },
        { "id": "ctrl-e.line-end", "keys": [{ "kind": "Character", "ctrl": true, "alt": false, "text": "e" }], "intent": "LineEnd", "context": "None", "description": "Move to the end of the line" },
        { "id": "ctrl-k.kill-to-end", "keys": [{ "kind": "Character", "ctrl": true, "alt": false, "text": "k" }], "intent": "KillToEnd", "context": "None", "description": "Kill to the end of the line" },
        { "id": "ctrl-u.kill-to-start", "keys": [{ "kind": "Character", "ctrl": true, "alt": false, "text": "u" }], "intent": "KillToStart", "context": "None", "description": "Kill to the start of the line" },
        { "id": "ctrl-w.kill-word-back", "keys": [{ "kind": "Character", "ctrl": true, "alt": false, "text": "w" }], "intent": "KillWordBack", "context": "None", "description": "Kill the word before the cursor" },
        { "id": "alt-d.kill-word-forward", "keys": [{ "kind": "Character", "ctrl": false, "alt": true, "text": "d" }], "intent": "KillWordForward", "context": "None", "description": "Kill the word after the cursor (Alt-free: Ctrl+Delete)" },
        { "id": "ctrl-delete.kill-word-forward", "keys": [{ "kind": "Delete", "ctrl": true, "alt": false }], "intent": "KillWordForward", "context": "None", "description": "Kill the word after the cursor without Alt (mirrors Alt+D)" },
        { "id": "ctrl-y.yank", "keys": [{ "kind": "Character", "ctrl": true, "alt": false, "text": "y" }], "intent": "Yank", "context": "None", "description": "Yank the last kill" },
        { "id": "ctrl-underscore.undo", "keys": [{ "kind": "Character", "ctrl": true, "alt": false, "text": "_" }], "intent": "Undo", "context": "None", "description": "Undo the last edit" },
        { "id": "alt-b.word-left", "keys": [{ "kind": "Character", "ctrl": false, "alt": true, "text": "b" }], "intent": "WordLeft", "context": "None", "description": "Move back by word (Alt-free: Ctrl+Left)" },
        { "id": "alt-f.word-right", "keys": [{ "kind": "Character", "ctrl": false, "alt": true, "text": "f" }], "intent": "WordRight", "context": "None", "description": "Move forward by word (Alt-free: Ctrl+Right)" },
        { "id": "ctrl-left.word-left", "keys": [{ "kind": "Left", "ctrl": true, "alt": false }], "intent": "WordLeft", "context": "None", "description": "Move back by word without Alt (mirrors Alt+B)" },
        { "id": "ctrl-right.word-right", "keys": [{ "kind": "Right", "ctrl": true, "alt": false }], "intent": "WordRight", "context": "None", "description": "Move forward by word without Alt (mirrors Alt+F)" },
        { "id": "up.history-previous", "keys": [{ "kind": "Up" }], "intent": "HistoryPrevious", "context": "None", "description": "Previous entry" },
        { "id": "down.history-next", "keys": [{ "kind": "Down" }], "intent": "HistoryNext", "context": "None", "description": "Next entry" }
    ],
    "guideRows": [
        {
            "id": "enter",
            "keys": [
                "Enter"
            ],
            "bindings": [
                "enter.follow-up",
                "enter.submit.idle",
                "enter.submit.bash"
            ],
            "action": "Send; with the autocomplete list open, accept the selected item first (an exact token sends instead); in bash mode, run the line through the `bash` tool; while a turn runs, queue the line as a follow-up (the footer shows `N queued`). Never steers or interrupts a turn"
        },
        {
            "id": "newline",
            "keys": [
                "Alt+Enter",
                "Shift+Enter",
                "Ctrl+J",
                "Ctrl+Enter"
            ],
            "bindings": [
                "newline.alt-enter",
                "newline.shift-enter",
                "newline.ctrl-j",
                "newline.ctrl-enter"
            ],
            "action": "New line in every state (the alternatives are for terminals that report extended keys or send the control byte); the autocomplete triggers re-run afterwards. Never submits or queues"
        },
        {
            "id": "escape",
            "keys": [
                "Esc"
            ],
            "bindings": [
                "escape.interrupt"
            ],
            "action": "Close the autocomplete list first; in bash mode, leave without running and restore the line with its prefix; otherwise interrupt the running turn, whose queued follow-ups then run next; with nothing running, leave the queue alone"
        },
        {
            "id": "ctrl-c",
            "keys": [
                "Ctrl+C"
            ],
            "bindings": [
                "ctrl-c.interrupt.turn",
                "ctrl-c.interrupt.command",
                "ctrl-c.clear-or-quit"
            ],
            "action": "Interrupt the running turn (a queued follow-up then runs next); with the prompt idle it clears the input, and on an empty idle prompt a second press within 2 s quits"
        },
        {
            "id": "ctrl-d",
            "keys": [
                "Ctrl+D"
            ],
            "bindings": [
                "ctrl-d.quit"
            ],
            "action": "Quit on a second press within 800 ms, only from an empty idle prompt — never mid-turn"
        },
        {
            "id": "ctrl-l",
            "keys": [
                "Ctrl+L"
            ],
            "bindings": [
                "ctrl-l.redraw"
            ],
            "action": "Force a full redraw of the prompt area, keeping the input and the conversation"
        },
        {
            "id": "unbound.ctrl-p",
            "keys": [
                "Ctrl+P"
            ],
            "reason": "deliberately unbound since #124: the model picker is Alt+P, and the guide lists it so a reader does not have to guess",
            "action": "Unbound: nothing happens. It is deliberately left free (the model picker is `Alt+P`), and the guide lists it so a reader does not have to guess"
        },
        {
            "id": "alt-p",
            "keys": [
                "Alt+P"
            ],
            "bindings": [
                "alt-p.model-picker"
            ],
            "action": "Model picker and search; typing filters the catalog, Backspace edits the filter, Esc clears it before closing"
        },
        {
            "id": "ctrl-r",
            "keys": [
                "Ctrl+R"
            ],
            "bindings": [
                "ctrl-r.history-search"
            ],
            "action": "History search: typing narrows, `Ctrl+R`/`Down` moves to the next match, `Enter` places it in the input, `Esc` cancels"
        },
        {
            "id": "ctrl-s",
            "keys": [
                "Ctrl+S"
            ],
            "bindings": [
                "ctrl-s.stash"
            ],
            "action": "Stash the draft, or restore it when the prompt is empty"
        },
        {
            "id": "ctrl-g",
            "keys": [
                "Ctrl+G"
            ],
            "bindings": [
                "ctrl-g.editor"
            ],
            "action": "Open the draft in your editor: `$VISUAL`, else `$EDITOR`, else `vi` on POSIX and `notepad` on Windows — arguments are split on whitespace, with no shell and no quoting. A zero exit replaces the draft with the file's text and puts the cursor at its end; the program must wait for the file (`code --wait`), or the draft is read before the edit lands"
        },
        {
            "id": "ctrl-underscore",
            "keys": [
                "Ctrl+_"
            ],
            "bindings": [
                "ctrl-underscore.undo"
            ],
            "action": "Undo the last input edit"
        },
        {
            "id": "help.question-mark",
            "keys": [
                "?"
            ],
            "reason": "gated on an empty idle prompt, a condition the context flags cannot express; in an approval prompt it shows the panel's key legend, so the row has behaviour behind it",
            "action": "On an empty idle prompt, open the key-help overlay: the bindings that apply here, grouped by state; `j`/`k` move, `/` filters, `Tab` shows every binding, `Esc` or `?` closes without touching the draft. In an approval prompt it shows that panel's key legend — `y` approves, `n` denies, `a` approves for the session, `Space` activates the selection, Enter and Esc deny — and decides nothing. With text in the prompt it is a literal character"
        },
        {
            "id": "approval.answers",
            "keys": [
                "y",
                "n",
                "a"
            ],
            "reason": "the approval panel owns its keys; the session returns before the router while a prompt is pending",
            "action": "Answer a pending approval: approve, deny, or approve for the whole session. The panel owns these letters, so nothing else sees them while a question is open"
        },
        {
            "id": "ctrl-o",
            "keys": [
                "Ctrl+O"
            ],
            "bindings": [
                "ctrl-o.transcript"
            ],
            "action": "Transcript viewer: the session transcript with full tool output and diffs; `q`, `Esc` or `Ctrl+O` closes. Refused while an approval or picker is open"
        },
        {
            "id": "ctrl-x",
            "keys": [
                "Ctrl+X"
            ],
            "bindings": [
                "ctrl-x.copy"
            ],
            "action": "Copy the last answer to the clipboard; the notice says whether a platform tool confirmed the write or the OSC 52 sequence was sent, and names tmux's `set-clipboard on` when it applies"
        },
        {
            "id": "tab",
            "keys": [
                "Tab"
            ],
            "bindings": [
                "tab.complete"
            ],
            "action": "Accept the selected autocomplete item; otherwise nothing"
        },
        {
            "id": "history",
            "keys": [
                "Up",
                "Down"
            ],
            "bindings": [
                "up.history-previous",
                "down.history-next",
                "up.take-back"
            ],
            "action": "Move the autocomplete selection; with the list closed, history (bash mode recalls its own command stream). With queued follow-ups, `Up` takes the whole queue back into the editor instead"
        },
        {
            "id": "line-bounds",
            "keys": [
                "Ctrl+A",
                "Ctrl+E"
            ],
            "bindings": [
                "ctrl-a.line-start",
                "ctrl-e.line-end"
            ],
            "action": "Move to the start / end of the line"
        },
        {
            "id": "kill-line",
            "keys": [
                "Ctrl+K",
                "Ctrl+U"
            ],
            "bindings": [
                "ctrl-k.kill-to-end",
                "ctrl-u.kill-to-start"
            ],
            "action": "Kill from the cursor to the end / to the start of the line"
        },
        {
            "id": "kill-word",
            "keys": [
                "Ctrl+W",
                "Alt+D",
                "Ctrl+Delete"
            ],
            "bindings": [
                "ctrl-w.kill-word-back",
                "alt-d.kill-word-forward",
                "ctrl-delete.kill-word-forward"
            ],
            "action": "Kill the word before / after the cursor (`Ctrl+Delete` is the Alt-free form of `Alt+D`)"
        },
        {
            "id": "yank",
            "keys": [
                "Ctrl+Y"
            ],
            "bindings": [
                "ctrl-y.yank"
            ],
            "action": "Yank the most recent kill"
        },
        {
            "id": "word-motion",
            "keys": [
                "Alt+B",
                "Alt+F",
                "Ctrl+Left",
                "Ctrl+Right"
            ],
            "bindings": [
                "alt-b.word-left",
                "alt-f.word-right",
                "ctrl-left.word-left",
                "ctrl-right.word-right"
            ],
            "action": "Move back / forward by word (`Ctrl+Left`/`Ctrl+Right` are the Alt-free forms)"
        }
    ]
}
