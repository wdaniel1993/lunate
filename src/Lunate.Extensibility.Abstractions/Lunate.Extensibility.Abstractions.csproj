<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>Lunate.Extensibility.Abstractions</RootNamespace>
        <!--
            The contract assembly's version *is* the API version: ExtensionApiGate compares an
            extension's referenced Lunate.Extensibility.Abstractions version with
            ExtensionApi.Current, and ExtensionApiTests holds the two equal.
        -->
        <Version>1.11.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Lunate.Extensibility" />
        <InternalsVisibleTo Include="Lunate.Extensibility.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Lunate.Agent/Lunate.Agent.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
        <PackageReference
            Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
            Version="5.6.0"
            PrivateAssets="all"
        />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="PublicAPI.Shipped.txt" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    </ItemGroup>
</Project>
