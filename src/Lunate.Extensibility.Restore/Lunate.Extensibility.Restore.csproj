<Project Sdk="Microsoft.NET.Sdk">
    <!--
        The NuGet client libraries live behind this assembly so that composing a session never
        loads them: a host that only loads already-built extensions has no NuGet.* assembly in the
        process (ADR 0017 addendum, "The libraries load only when a restore runs"). Only this
        project references them; Lunate.Extensibility holds the lock, the digest and the restore
        policy and knows nothing about NuGet.
    -->
    <ItemGroup>
        <ProjectReference Include="../Lunate.Extensibility/Lunate.Extensibility.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            Every type here is internal: this assembly is the NuGet half of the CLI's install,
            uninstall and single-file restore, not a contract. Nothing outside Lunate references it,
            and a surface nobody can consume is a surface nothing should promise — so the only
            external access is the in-repo consumer and the suites that test it.
        -->
        <InternalsVisibleTo Include="lunate" />
        <InternalsVisibleTo Include="Lunate.Coding.Tests" />
        <InternalsVisibleTo Include="Lunate.Extensibility.Compile.Tests" />
        <InternalsVisibleTo Include="Lunate.Extensibility.Tests" />
        <!-- The dependency walker's rules are the restore's rules; the tests assert a version
             choice at that seam, without an install or a reference pack in the way. -->
        <InternalsVisibleTo Include="Lunate.Extensibility.Restore.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NuGet.Configuration" Version="7.9.0" />
        <PackageReference Include="NuGet.Frameworks" Version="7.9.0" />
        <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
        <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
        <PackageReference Include="NuGet.Versioning" Version="7.9.0" />
    </ItemGroup>

    <PropertyGroup>
        <!--
            NuGet.Packaging signs packages with System.Security.Cryptography.Pkcs 8.0.1, which carries
            two published advisories. Lunate never verifies or produces a signature (signature
            verification is out of scope for this change and recorded as a follow-up), so the
            advisory does not describe reachable code here. Suppressed narrowly — not by turning the
            audit off — so a new advisory on any other package still fails the build.
        -->
        <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
    </PropertyGroup>
</Project>
