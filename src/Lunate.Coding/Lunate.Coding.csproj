<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>lunate</AssemblyName>
        <RootNamespace>Lunate.Coding</RootNamespace>
        <PackAsTool>true</PackAsTool>
        <IsPackable>true</IsPackable>
        <ToolCommandName>lunate</ToolCommandName>
        <PackageId>lunate</PackageId>
        <Description>A native C# coding agent for the terminal.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Lunate.Agent/Lunate.Agent.csproj" />
        <ProjectReference Include="../Lunate.Extensibility/Lunate.Extensibility.csproj" />
        <ProjectReference Include="../Lunate.Extensibility.Compile/Lunate.Extensibility.Compile.csproj" />
        <ProjectReference Include="../Lunate.Extensibility.Restore/Lunate.Extensibility.Restore.csproj" />
        <ProjectReference Include="../Lunate.Protocols/Lunate.Protocols.csproj" />
        <ProjectReference Include="../Lunate.Roslyn/Lunate.Roslyn.csproj" />
        <ProjectReference Include="../Lunate.Tui/Lunate.Tui.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Lunate.Coding.Tests" />
        <!-- The ACP pipe tests compose the policy-first approver and the tool seam directly. -->
        <InternalsVisibleTo Include="Lunate.Protocols.Tests" />
        <!-- The MCP-from-extensions test composes the real extension host with the server mapping. -->
        <InternalsVisibleTo Include="Lunate.Extensibility.Testing.Tests" />
        <!-- The testing kit composes the production MCP mapping over real registrations. -->
        <InternalsVisibleTo Include="Lunate.Extensibility.Testing" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="system-prompt.md" LogicalName="Lunate.Coding.system-prompt.md" />
    </ItemGroup>
</Project>
