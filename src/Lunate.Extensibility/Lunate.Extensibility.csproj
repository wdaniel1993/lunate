<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <ProjectReference Include="../Lunate.Agent/Lunate.Agent.csproj" />
        <ProjectReference Include="../Lunate.Ai/Lunate.Ai.csproj" />
        <ProjectReference Include="../Lunate.Extensibility.Abstractions/Lunate.Extensibility.Abstractions.csproj" />
        <ProjectReference Include="../Lunate.Extensibility.Remote/Lunate.Extensibility.Remote.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The SKILL.md frontmatter reader is one parser: the skill scanner in Lunate.Coding
             (assembly name "lunate") and the package reader in Lunate.Extensibility.Restore both
             read a skill with it, so a package's skill is judged by the same rules a hand-placed
             one is. -->
        <InternalsVisibleTo Include="lunate" />
        <InternalsVisibleTo Include="Lunate.Extensibility.Restore" />
        <!-- The install/trust integration tests read the provenance index the loader reads, so a
             record written by the installer and one read here can never drift apart silently. -->
        <InternalsVisibleTo Include="Lunate.Extensibility.Tests" />
    </ItemGroup>
</Project>
